+        rows,
+        rails: Rail::ALL
+            .iter()
+            .map(|r| RailState {
+                pill: Pill::SignIn,
+                installed: true,
+                show_connect: true,
+                ..RailState::detecting(*r)
+            })
+            .collect(),
+        default_selection: None,
+        secret_backend: None,
+    });
+    assert_eq!(
+        app.connection_picker.as_ref().unwrap().tab,
+        workshop_auth::PickerTab::Subscriptions
+    );
+    assert_eq!(app.connection_picker.as_ref().unwrap().rail_selected, 0);
+}
