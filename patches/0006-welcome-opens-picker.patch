+/// Enter on a non-xAI card (Local, OpenAI, …) opens setup details and never emits `Authenticate`.
+#[test]
+fn picker_non_xai_cards_never_authenticate() {
+    use workshop_auth::{PickerInput, XAI_ROW_ID};
+    let mut app = test_app();
