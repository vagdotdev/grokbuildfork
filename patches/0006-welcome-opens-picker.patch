+/// Which backend a submitted prompt should run on.
+pub enum WorkshopTurnKind {
+    Engine {
+        slot: EngineSlot,
+        session: Option<String>,
+        model: EngineModel,
+    },
+    Adapter {
+        adapter_id: AdapterId,
