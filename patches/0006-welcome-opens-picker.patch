+
+    let effects = dispatch(Action::WorkshopFirstRun, &mut app);
+
+    assert!(app.connection_picker.is_none(), "first run shows no picker");
+    let crate::app::workshop::WorkshopConnection::Engine { model } = &app.workshop_connection
+    else {
