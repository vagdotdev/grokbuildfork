#!/bin/sh
# Fake Cursor Agent CLI (shapes from Cursor Agent 2026.09.18 and the documented stream-json format).
. "$(dirname "$0")/_common.sh"
record cursor "$@"
case "$1" in
  --version|-v) echo "2026.09.18-9a7762b"; exit 0 ;;
  --help|-h) echo "Usage: agent [options] [command] [prompt...]"; echo; echo "Start the Cursor Agent"; exit 0 ;;
  status|whoami)
    case "${FAKE_LOGIN_CURSOR:-out}" in
      in) printf '{"status":"authenticated","isAuthenticated":true,"hasAccessToken":true,"message":"Logged in"}\n'; exit 0 ;;
      garbage) echo "Logged in as someone"; exit 0 ;;
      *) printf '{"status":"unauthenticated","isAuthenticated":false,"hasAccessToken":false,"message":"Not logged in"}\n'; exit 0 ;;
    esac ;;
  login) echo "fake cursor login"; exit 0 ;;
  -p) ;;
  *) echo "fake cursor-agent: unsupported args: $*" >&2; exit 64 ;;
esac
# ---- run mode: agent -p --output-format stream-json --workspace DIR --trust [--force] [--resume=ID] PROMPT
record_run cursor "$@"
session=""
for a in "$@"; do
  case "$a" in --resume=*) session="${a#--resume=}" ;; esac
done
[ -n "$session" ] || session=$(new_session fake-cursor)
turn=$(next_turn "$session")
case "$(mode)" in
  fail)
    echo "Error: Authentication required. Please run 'agent login' first, or set CURSOR_API_KEY environment variable." >&2
    exit 1 ;;
esac
printf '{"type":"system","subtype":"init","model":"Auto","session_id":"%s","cwd":"%s"}\n' "$session" "$(pwd)"
apply_mode cursor || exit 0
printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"Analyzing the project."}]},"session_id":"%s"}\n' "$session"
sleep 0.05
printf '{"type":"tool_call","subtype":"started","call_id":"call_1","tool_call":{"readToolCall":{"args":{"path":"README.md"}}},"session_id":"%s"}\n' "$session"
printf '{"type":"tool_call","subtype":"completed","call_id":"call_1","tool_call":{"readToolCall":{"args":{"path":"README.md"},"result":{"success":{"totalLines":1}}}},"session_id":"%s"}\n' "$session"
printf '{"type":"assistant","message":{"role":"assistant","content":[{"type":"text","text":"turn %s of %s"}]},"session_id":"%s"}\n' "$turn" "$session" "$session"
printf '{"type":"result","subtype":"success","duration_ms":800,"is_error":false,"result":"turn %s of %s","session_id":"%s"}\n' "$turn" "$session" "$session"
[ "$(mode)" = "exit_nonzero" ] && exit 3
exit 0
